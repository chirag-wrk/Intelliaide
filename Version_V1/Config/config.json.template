    "price_per_1m_output_tokens": "USD per 1M output tokens (for cost table display; default 15.0)",
    "max_iterations": "Maximum number of tool-call iterations for the ReAct agent loop (default: 25)",
    "max_deepening_rounds": "Maximum deepening rounds HIGH -> MEDIUM -> LOW (default: 3)"
